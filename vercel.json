{
  "redirects": [
    {
      "source": "/(.*)",
      "missing": [
        {
          "type": "host",
          "value": "www.digitalmenue.com"
        }
      ],
      "destination": "https://www.digitalmenue.com/$1",
      "permanent": true
    }
  ],
  "framework": "nextjs",
  "buildCommand": "next build",
  "devCommand": "next dev",
  "installCommand": "npm install",
  "regions": ["sin1"],
  "functions": {
    "app/api/superadmin/analytics/route.ts": {
      "maxDuration": 60
    },
    "app/api/superadmin/restaurants-stats/route.ts": {
      "maxDuration": 30
    },
    "app/api/superadmin/customers/route.ts": {
      "maxDuration": 30
    },
    "app/api/orders/route.ts": {
      "maxDuration": 30
    },
    "app/api/trial/reminders/check/route.ts": {
      "maxDuration": 30
    },
    "app/api/menu/[slug]/route.ts": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/cron/refresh-stats",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/cleanup-rate-limits",
      "schedule": "15 3 * * *"
    },
    {
      "path": "/api/cron/check-subscriptions",
      "schedule": "30 8 * * *"
    }
  ]
}
