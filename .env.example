# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Connection pooler URL for high-concurrency serverless environments.
# Uses Supabase pgBouncer on port 6543. Format:
# postgres://postgres.[project-ref]:[password]@[project-ref]-pooler.supabase.co:6543/postgres?pgbouncer=true
# Falls back to direct connection if not set.
SUPABASE_POOL_URL=postgres://postgres.your-project-ref:your-password@your-project-ref-pooler.supabase.co:6543/postgres?pgbouncer=true

# Email (Resend)
# IMPORTANT: The sending domain (noreply@<APP_URL hostname>) must be verified
# on https://resend.com/domains or all transactional email is rejected (403).
RESEND_API_KEY=re_your-resend-key

# Admin
SUPER_ADMIN_EMAIL=your-admin-email@gmail.com

# App
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app
NEXT_PUBLIC_APP_NAME=QRMenu.pk

# SEO: Set to "true" to block all restaurant menu pages from search engines (deprecated — no index used directly, kept for reference)
# NEXT_PUBLIC_NOINDEX_MENU_PAGES=

# Web Push Notifications (VAPID keys)
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:your-email@example.com

# AI Poster Generation (Gemini / Imagen)
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
# Optional overrides (defaults shown):
# GEMINI_IMAGE_MODEL=imagen-3.0-generate-001
# GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com
