# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email (Resend)
RESEND_API_KEY=re_your-resend-key

# Admin
SUPER_ADMIN_EMAIL=your-admin-email@gmail.com

# App
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app
NEXT_PUBLIC_APP_NAME=QRMenu.pk

# SEO: Set to "true" to block all restaurant menu pages from search engines
NEXT_PUBLIC_NOINDEX_MENU_PAGES=true

# AI Image Generation (OpenRouter)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key

# JazzCash Payment Gateway
# SANDBOX mode (testing): MERCHANT_ID=TEST00127801, PASSWORD=00000000000, HASH_KEY=0F5DD14AE2, SANDBOX=true
# LIVE mode: Replace with credentials from JazzCash merchant team, set SANDBOX=false
JAZZCASH_MERCHANT_ID=TEST00127801
JAZZCASH_PASSWORD=00000000000
JAZZCASH_HASH_KEY=0F5DD14AE2
JAZZCASH_SANDBOX=true
NEXT_PUBLIC_JAZZCASH_ENABLED=true

# Web Push Notifications (VAPID keys)
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:your-email@example.com
